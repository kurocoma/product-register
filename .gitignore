__pycache__/
*.egg-info/
dist/
output/
logs/*.json
logs/*.txt
.venv/

# 外部API資料・サンプルデータは git 管理外
# 設計書・計画書 (docs/superpowers/) は追跡対象として残す
docs/*
!docs/superpowers/
!docs/superpowers/**
# アーキテクチャ監査（分析・設計ドキュメント）は追跡対象
!docs/architecture-audit/
!docs/architecture-audit/**

# 旧 plans/plan.md (Phase 1 全体計画書) は git 管理外
# docs/superpowers/plans/ は追跡対象 (上のルールで !docs/superpowers/** 済み)
/plans/

# eval-loop の実行時成果物（ハーネスのコード・完了記録は追跡、稼働状態とログは管理外）
.loop/current/
validation/runs/*
!validation/runs/.gitkeep
validation/archive/

# ハーネス実行時の生成物（セッション状態・一時ファイル・HTMLレポート）は管理外
# ※ .agents/ .claude/ .codex/ .loop/archive-* は意図確認まで untracked のまま残す（M0 参照）
.mso/
webui/.mso/
.tmp/
/outputs/
/eval-loop-report.html
/loop-progress.html
/question-dashboard.html
